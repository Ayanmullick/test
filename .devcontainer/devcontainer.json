{
    "name": "AzPSImage",
    "image": "mcr.microsoft.com/azure-powershell:latest",
    "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "16gb" },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
    },
    "postCreateCommand": "bash -lc 'command -v npm >/dev/null 2>&1 || (apt-get update && apt-get install -y nodejs npm); npm install -g @openai/codex'",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.profiles.linux": {
                    "pwsh": { "path": "pwsh", "args": ["-NoLogo"] }
                },
                "terminal.integrated.defaultProfile.linux": "pwsh",
                "terminal.integrated.automationProfile.linux": { "path": "pwsh", "args": ["-NoLogo", "-NoProfile"] },
                "files.defaultLanguage": "powershell",

                "workbench.sideBar.location": "right",
                "editor.multiCursorModifier": "ctrlCmd", "editor.minimap.enabled": false, "editor.accessibilitySupport": "on", "editor.tabCompletion": "on",
                "editor.snippetSuggestions": "bottom", "editor.suggest.snippetsPreventQuickSuggestions": true, "editor.rulers": [125],
                "editor.bracketPairColorization.enabled": true, "editor.guides.bracketPairs": "active"

            },

            "extensions":
            ["ms-vscode.powershell",
             "ibm.output-colorizer",
                 "github.copilot", "github.copilot-chat", "openai.chatgpt", "GitHub.vscode-github-actions",
                //Remove-Item Env:GITHUB_TOKEN
                //gh auth login
                //gh workflow list                                                      
                //gh workflow run 'Process Report' --ref master  //GHActions extension doesn't work on the browser. GH CLI only option
             "ms-azuretools.vscode-azurefunctions","ms-azuretools.vscode-azureresourcegroups",
             "ms-dotnettools.vscode-dotnet-runtime","ms-toolsai.jupyter","ms-toolsai.vscode-jupyter-cell-tags"
            ]
        }
    }
}
