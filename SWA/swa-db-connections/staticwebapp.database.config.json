{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v1.3.19/dab.draft.schema.json",
  "data-source": { "database-type": "mssql", "connection-string": "@env('DATABASE_CONNECTION_STRING')" },
  "runtime": {
    "rest": { "enabled": true, "path": "/rest" },
    //"graphql": { "enabled": false },
    "host": { "mode": "development", "cors": {"origins": ["http://localhost:4280"]},
/*"host": { "mode": "production", "authentication": { "provider": "AppService" } }

"host": { "mode": "development", "cors": {"origins": ["http://localhost:4280"]}, "authentication": { "provider": "StaticWebApps" }}
Don't use the old Static Web App provider with a development mode for Static Web App, but it is okay to use the old one.
*/
    "authentication": { "provider": "StaticWebApps" }}
  },
  "entities": {
    /*"TestSales": {
      "source": "dbo.TestSales",
      "permissions": [
        //{ "role": "anonymous", "actions": ["read"] },
        { "role": "authenticated", "actions": ["read"] }
      ]
    },*/
    "TestSalesByPrincipal": {
      "source": {
        "object": "Security.usp_SelectTestSalesByPrincipal",
        "type": "stored-procedure"
      },
      "permissions": [
        { "role": "authenticated", "actions": ["execute"] }
      ]
    }
  }
}
